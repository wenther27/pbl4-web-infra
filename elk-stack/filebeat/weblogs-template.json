{
  "index_patterns": ["weblogs-*"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 1024 }
          }
        }
      ],
      "properties": {
        "@timestamp": { "type": "date" },
        "message":    { "type": "text" },
        "level":      { "type": "keyword" },
        "instance":   { "type": "keyword" },
        "httpMethod": { "type": "keyword" },
        "path":       { "type": "keyword" },
        "status":     { "type": "integer" },
        "durationMs": { "type": "long" },
        "clientIp":   { "type": "ip" }
      }
    }
  }
}
